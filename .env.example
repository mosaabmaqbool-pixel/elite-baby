# Only used before the first admin account is created. Set as a Sites secret.
ADMIN_SETUP_KEY=

# Backend only. Configure through hosting Secrets; never put real values in this file.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_NUMBER=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=
WHATSAPP_API_VERSION=

# Public canonical origin, no trailing path. Change after connecting your final domain.
SITE_URL=

# Customer WhatsApp authentication template (AUTHENTICATION + Copy Code button).
WHATSAPP_AUTH_TEMPLATE_NAME=
WHATSAPP_AUTH_TEMPLATE_LANGUAGE=
# Backend-only independent random secret, minimum 32 characters; keep outside Git.
CUSTOMER_OTP_SECRET=
